# ==============================================================================
# YourLLM Environment Configuration
# Principle: Bring Your Own Compute. Deploy Your Own Model. Get Your Own API.
# ==============================================================================

# ------------------------------------------------------------------------------
# Model Settings (Required & Identity)
# ------------------------------------------------------------------------------
# Hugging Face repository ID (e.g. meta-llama/Llama-3.1-8B-Instruct, Qwen/Qwen2.5-7B-Instruct)
YLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Name exposed via OpenAI-compatible endpoints /v1/models and completions (defaults to YLLM_MODEL)
YLLM_SERVED_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# Profile name from src/yourllm/models/profiles/ or "auto" to match by HF repo ID
YLLM_PROFILE=auto

# Optional Hugging Face access token for gated models (never logged or exposed)
HF_TOKEN=

# ------------------------------------------------------------------------------
# Gateway Network & Security Settings
# ------------------------------------------------------------------------------
# Port for the YourLLM gateway HTTP server (default: 8000)
YLLM_PORT=8000

# Base persistent data directory in container (default: /data)
YLLM_DATA_DIR=/data

# Admin token required to access /admin/* HTTP endpoints.
# If unset, /admin/* returns 404 and CLI is the only management path.
YLLM_ADMIN_TOKEN=

# Gateway concurrency cap (returns 429 Retry-After when saturated)
YLLM_MAX_CONCURRENT_REQUESTS=16

# Upstream request timeout in seconds
YLLM_REQUEST_TIMEOUT_S=600.0

# Maximum request body size limit in bytes (default: 10MB)
YLLM_MAX_REQUEST_BYTES=10485760

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
YLLM_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# vLLM Engine & Hardware Tuning
# ------------------------------------------------------------------------------
# Context length ceiling (tokens). If unset, defaults to model config.
YLLM_MAX_MODEL_LEN=32768

# Fraction of GPU VRAM vLLM may reserve for weights and KV cache (0.0 < value <= 1.0)
YLLM_GPU_MEMORY_UTILIZATION=0.90

# Weight precision: auto, half, float16, bfloat16, float32
YLLM_DTYPE=auto

# Quantization method: awq, gptq, fp8, bitsandbytes, squeezellm, or unset
YLLM_QUANTIZATION=

# Number of GPUs for single-node tensor parallelism (>= 1)
YLLM_TENSOR_PARALLEL_SIZE=1

# Maximum concurrent sequences per execution batch
YLLM_MAX_NUM_SEQS=

# Automatic prefix caching (reuses KV-cache for repeated system prompts/history)
YLLM_ENABLE_PREFIX_CACHING=true

# KV-cache storage precision: auto, fp8, fp8_e4m3, fp8_e5m2
YLLM_KV_CACHE_DTYPE=auto

# Tool call parser override (hermes, llama3_json, mistral, granite, pythonic, openai)
YLLM_TOOL_CALL_PARSER=

# Chat template override (path to Jinja template file)
YLLM_CHAT_TEMPLATE=

# Allow execution of custom model code from Hugging Face (default false)
YLLM_TRUST_REMOTE_CODE=false

